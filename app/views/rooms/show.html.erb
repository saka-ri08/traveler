<div class="cover-room-show">
 <div class="col-md-12 border_right border_left d-flex flex-column justify-content-between vh-100">

  <div class="d-flex align-items-center py-2">
    <%= link_to root_path, class: "text-dark" do %>
      <i class="fa-solid fa-arrow-left arrow-left"></i>
    <% end %>

    <div class="profile_top_name">
      <h3>
        <%= @another_entry.user.name %> さんとのメッセージ
      </h3>
    </div>
  </div>

  <div class="chat-body p-3 flex-grow-1 overflow-auto">
    <% @messages.each do |m| %>
      <% if m.user_id == current_user.id %>
        <div class="d-flex justify-content-end mb-3">
          <div class="mycomment p-2 rounded d-inline-block">
            <%= m.message %>
          </div>
        </div>
      <% else %>
        <div class="d-flex justify-content-start mb-3">
          <div class="fukidasi">
           <div class="faceicon">
            <% if m.user.profile_image.attached? %>
             <%= image_tag m.user.profile_image, class: "message_icon_img" %>
            <% else %>
             <%= image_tag "no_image.svg", class: "message_icon_img" %>
            <% end %>
           </div>
           <div class="mycomment">
            <%= m.message %>
           </div>
         </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="chat-form-box p-3">
    <%= form_with model: [@room, @message] do |f| %>
      <div class="chat-form-group d-flex">
        <%= f.text_field :message, class: "form-control mr-2 flex-grow-1" %>
        <%= f.hidden_field :room_id, value: @room.id %>
        <%= f.submit "送信", class: "btn message_submit" %>
      </div>
    <% end %>
  </div>

 </div>
</div>